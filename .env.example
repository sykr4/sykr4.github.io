# Server only. Copy to .env.local for development; never commit credentials.
# Resend is the implemented provider. CONTACT_FROM must be a verified sender.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Exact public origin, without path. Development example; adjust your port.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Production Node server (behind HTTPS reverse proxy):
HOST=127.0.0.1
PORT=3000
# Only enable behind ONE trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Optional existing endpoint. Must provide server validation/abuse protection.
# Empty uses the included /api/contact backend. Never place keys in VITE_*.
VITE_CONTACT_ENDPOINT=
# Legacy offline modes, optional and never presented as delivery:
# VITE_CONTACT_MODE=download
# VITE_CONTACT_MODE=email
# VITE_CONTACT_EMAIL=
